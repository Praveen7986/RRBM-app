rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.uid == 'rrbm-manager-admin'
      );
    }

    function volunteerDoc(volId) {
      return get(/databases/$(database)/documents/volunteers/$(volId));
    }

    function isVolunteerOwner(volId) {
      return isAuthenticated() && (
        request.auth.uid == volunteerDoc(volId).data.uid ||
        request.auth.token.email == volId.lower() + '@volunteer.rrbm.org'
      );
    }

    function isParentAlertActive(alertId) {
      return exists(/databases/$(database)/documents/alerts/$(alertId)) &&
        get(/databases/$(database)/documents/alerts/$(alertId)).data.status == 'active';
    }

    // Volunteers Collection:
    // - Authenticated volunteers can read profiles
    // - Profile creation and deletion strictly reserved for Admin (via Admin SDK)
    // - Volunteers can only update heartbeat (lastActive) on their own record
    // - Volunteers cannot change their profile uid or any other identity attributes
    match /volunteers/{volunteerId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isVolunteerOwner(volunteerId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActive'])
      );
    }

    // Emergency Alerts:
    // - Authenticated volunteers can read alerts
    // - Alert creation restricted to authenticated volunteers matching triggeredBy.id with status 'active'
    // - Only Admins can modify status (resolve) or delete alerts
    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.status == 'active' &&
        (isAdmin() || isVolunteerOwner(request.resource.data.triggeredBy.id));
      allow update, delete: if isAdmin();

      // Per-Volunteer Alert Responses Subcollection:
      // - Prevents concurrent overwrite conflicts
      // - Allowed only while parent alert (/alerts/{alertId}) is currently active
      // - Volunteers can only write to their own response document (/alerts/{alertId}/responses/{volId})
      // - Strictly validates schema: volunteerId, volunteerName, responseType, updatedAt
      // - Requires updatedAt == request.time (server timestamp)
      // - Requires volunteerName == get(/databases/$(database)/documents/volunteers/$(volId)).data.name
      // - Response deletion reserved exclusively for Admins
      match /responses/{volId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() &&
          isParentAlertActive(alertId) &&
          isVolunteerOwner(volId) &&
          request.resource.data.keys().hasOnly(['volunteerId', 'volunteerName', 'responseType', 'updatedAt']) &&
          request.resource.data.volunteerId == volId &&
          request.resource.data.responseType in ['coming', 'coming_late', 'not_coming'] &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.volunteerName == volunteerDoc(volId).data.name;
        allow delete: if isAdmin();
      }
    }

    // Alerts History:
    // - Authenticated volunteers can read archived alerts
    // - Archive creation restricted to active alerts triggered by verified volunteers or admins
    // - Only Admins can modify or delete alert history records
    match /alerts_history/{alertId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.status == 'active' &&
        (isAdmin() || isVolunteerOwner(request.resource.data.triggeredBy.id));
      allow update, delete: if isAdmin();
    }

    // Live Coordination Chat:
    // - Authenticated users can read chat
    // - Creates strictly validate sender identity against authenticated volunteer profile
    // - Prevents volunteer impersonation
    // - Admin chat privileges match server-minted admin credentials
    match /chat/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 1000 &&
        request.resource.data.volunteerId is string &&
        request.resource.data.senderName is string &&
        request.resource.data.type in ['chat', 'alert', 'quick_response'] &&
        (
          isAdmin() ||
          (
            request.resource.data.volunteerId != 'OFFICE' &&
            request.resource.data.volunteerId != 'LEAD' &&
            isVolunteerOwner(request.resource.data.volunteerId) &&
            request.resource.data.senderName == volunteerDoc(request.resource.data.volunteerId).data.name
          )
        );
      allow update, delete: if isAdmin();
    }

    // System Settings & Money Jar Offering Balance:
    // - Volunteers can read balance
    // - Write restricted strictly to authorized Admin
    match /system/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Internal rate limits and server state:
    // - Client access completely forbidden (Admin SDK bypasses security rules)
    match /system_internal/{document=**} {
      allow read, write: if false;
    }

    // Deny all other paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
