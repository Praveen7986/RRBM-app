rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify if the requester is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Volunteers Collection:
    // - Authenticated volunteers can read volunteer profiles
    // - Volunteers can only update their own heartbeat / lastActive
    // - Passwords are never permitted in Firestore
    match /volunteers/{volunteerId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActive', 'active'])
      );
      // Volunteer provisioning is controlled by authenticated admin
      // Plain passwords are strictly forbidden and rejected from Firestore documents
      allow create: if isAuthenticated() && 
        !('password' in request.resource.data) && 
        !('plainPassword' in request.resource.data) && 
        !('pwd' in request.resource.data);
      allow delete: if false;
    }
    
    // Emergency Alerts:
    // - Authenticated volunteers can read active alerts
    // - Authenticated volunteers can broadcast alerts and submit responses
    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
    }
    
    // Alerts History:
    match /alerts_history/{alertId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
    }

    // Live Coordination Chat:
    // - Authenticated volunteers can read coordination chat
    // - Authenticated volunteers can post messages (up to 1000 chars)
    match /chat/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
      allow update, delete: if false;
    }

    // System Settings & Offering Balance:
    match /system/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
