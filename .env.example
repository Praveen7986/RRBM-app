# ==========================================
# RRBM 3-Day Fasting Prayers 2026 Environment Configuration
# Template file: Safe for version control / GitHub
# DO NOT place actual secrets, passwords, or private keys here.
# Configure real values directly in Render's Private Environment Variables dashboard.
# ==========================================

# ------------------------------------------
# Backend Server Configuration (Render Web Service)
# ------------------------------------------
# Server Port (Render sets this automatically; default 3000 locally)
PORT=3000

# Mandatory Admin Secret Key (min 8 characters, required to boot server)
ADMIN_SECRET=

# Firebase Admin SDK Service Account (Optional: paste raw JSON string into Render private env vars)
# FIREBASE_SERVICE_ACCOUNT_KEY=

# ------------------------------------------
# Frontend Client Configuration (Vite Build)
# ------------------------------------------
# Backend Server URL (Leave blank on Render if serving frontend from same host)
VITE_API_URL=
VITE_WS_URL=

# APK Manifest location
VITE_UPDATE_MANIFEST_URL=/rrbm-app/update.json

# Firebase Client Configuration (Populate in Render or local build)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
